# --- Database ---------------------------------------------------------
# PostgreSQL connection string. Use a pooled connection in production
# (e.g. PgBouncer / Neon / Supabase pooler) if you deploy serverless.
DATABASE_URL="postgresql://premia:premia@localhost:5432/premia?schema=public"

# --- Auth (NextAuth) ----------------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Admin bootstrap ------------------------------------------------
# Used only by `npm run db:seed` to create the first admin account.
# Change the password immediately after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"

# --- Cron / internal jobs -----------------------------------------------
# Shared secret required by /api/cron/expire-promotions so the endpoint
# can't be triggered by anyone who finds the URL.
CRON_SECRET="replace-with-a-random-secret"

# --- Site ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="Bankmiplaci"

# --- E-mail (Resend) ------------------------------------------------
# Klucz API z panelu Resend (Domains → API Keys).
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="Bankmiplaci <powiadomienia@mail.bankmiplaci.pl>"
SUPPORT_EMAIL="pomoc@bankmiplaci.pl"
